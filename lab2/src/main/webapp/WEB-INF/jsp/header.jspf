<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<header>
    <nav class="nav-bar">
        <a href="${pageContext.request.contextPath}/date-app/" class="nav-logo">DatingApp</a>
        <ul class="nav-links">
            <li><a href="${pageContext.request.contextPath}/date-app/">Home</a></li>
            <c:if test="${empty sessionScope.user}">
                <li><a href="${pageContext.request.contextPath}/date-app/login">Login</a></li>
                <li><a href="${pageContext.request.contextPath}/date-app/register">Register</a></li>
            </c:if>
            <c:if test="${not empty sessionScope.user}">
                <li><a href="${pageContext.request.contextPath}/date-app/profile?id=${sessionScope.user.id}">${sessionScope.user.username}</a></li>
                <li>
                    <form class="inline-form" action="${pageContext.request.contextPath}/date-app/logout" method="post">
                        <button type="submit" class="button logout-btn">Logout</button>
                    </form>
                </li>
            </c:if>
        </ul>
        <form class="search-form" action="${pageContext.request.contextPath}/date-app/search" method="get">
            <input type="text" name="search" placeholder="Search profiles..." class="search-input" />
            <button type="submit" class="button search-btn">🔍</button>
        </form>
    </nav>
</header>
