<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<header>
    <div class="topnav">
        <a class="active" href="/date-app/home">Home</a>
        <c:if test="${!empty profile}">
            <div class="creating">
                <form action="/date-app/register" method="POST">
                    <button type="submit">Create New Profile</button>
                </form>
            </div>
        </c:if>
        <c:if test="${!empty user}">
            <div class="login-container">
                <div style="outline: 1px solid black; border-radius: 10px; padding: 5px;">
                    <a href="/date-app/profile?id=${user.id}"><c:out value="${user.username}"/></a>
                </div>
                <form action="/date-app/logout" method="POST">
                    <button type="submit">Logout</button>
                </form>
            </div>
        </c:if>
        <c:if test="${empty user}">
            <div class="login-container">
                <form action="/date-app/login" method="POST">
                    <button type="submit">Login</button>
                    <button type="submit" formaction="register">Register</button>
                </form>
            </div>
        </c:if>
        <div class="search-container">
            <form action="/date-app/search">
                <input type="text" placeholder="Search.." name="search">
                <button type="submit">🔍</button>
            </form>
        </div>
    </div>
</header>